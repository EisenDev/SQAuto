# .env.example
# Copy this to .env on the VM and fill in real values.
# NEVER commit .env to git.

# ─── Metadata Database (Supabase Pooler) ──────────────────────────────────────
# Use transaction pooler mode (port 6543) with sslmode=require.
METADATA_DATABASE_URL=postgresql+psycopg://postgres.qbfniskixopblevelwcw:SQ4UT0101%21RUNNER@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.qbfniskixopblevelwcw:SQ4UT0101%21RUNNER@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# ─── Staging Database (Isolated Local Container) ──────────────────────────────
# Heavy dump restore/analyze work stays on the isolated staging container.
STAGING_DATABASE_URL=postgresql+psycopg://postgres:postgres@db_staging:5432/staging_db

# ─── Database passwords (used by docker-compose) ──────────────────────────────
DB_STAGING_PASSWORD=postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Application Ports ────────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000
SQAUTO_DB_PORT=55432       # metadata DB host port
SQAUTO_STAGING_DB_PORT=55433  # staging DB host port

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-secure-secret-key-here
AUTH_SECRET=generate-a-secure-secret-key-here
NEXTAUTH_SECRET=generate-a-secure-secret-key-here
# NOTE: Do NOT set AUTH_URL or NEXTAUTH_URL in self-hosted deployments.
# Doing so triggers a NextAuth v5 constructor bundling conflict (TypeError: tF is not a constructor).
# NextAuth will automatically detect the URL correctly using the trusted host header.
# AUTH_URL=http://sqauto.zeraynce.com
# NEXTAUTH_URL=http://sqauto.zeraynce.com
AUTH_TRUST_HOST=true

# ─── AI (Optional) ────────────────────────────────────────────────────────────
# GOOGLE_API_KEY=your-api-key-here

# ─── Frontend (Next.js build arg — set as GitHub Actions secret too) ──────────
NEXT_PUBLIC_API_URL=http://sqauto.zeraynce.com/api

# ─── Docker image registry (used by docker-compose on the VM) ────────────────
# These are set by the deploy script automatically; shown here for reference.
# CONTAINER_REGISTRY=ghcr.io
# IMAGE_NAMESPACE=eisendev
# IMAGE_TAG=latest
