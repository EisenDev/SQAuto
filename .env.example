# .env.example
# Metadata Database
# Local development uses the Postgres container started by ./run.sh.
# For Supabase, use the pooler / transaction mode URL (port 6543) with sslmode=require.
METADATA_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55433/sqauto

# Legacy compatibility alias. Keep this equal to METADATA_DATABASE_URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55433/sqauto

# Staging Database (heavy restore/analyze work should stay off Supabase)
STAGING_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55433/staging_db

# Redis Configuration (Broker/Cache)
REDIS_URL=redis://localhost:6379/0

# Application Ports
API_PORT=8000
WEB_PORT=3000
SQAUTO_DB_PORT=55433

# Security (Future use)
SECRET_KEY=generate-a-secure-secret-key-here

# AI Model Configuration (Optional)
# GOOGLE_API_KEY=your-api-key-here

# Integration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
