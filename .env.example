# .env.example
# PostgreSQL Connection (Staging DB)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sqauto

# Redis Configuration (Broker/Cache)
REDIS_URL=redis://localhost:6379/0

# Application Ports
API_PORT=8000
WEB_PORT=3000

# Security (Future use)
SECRET_KEY=generate-a-secure-secret-key-here

# AI Model Configuration (Optional)
# GOOGLE_API_KEY=your-api-key-here
