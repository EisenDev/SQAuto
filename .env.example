# .env.example
# PostgreSQL Connection (Staging DB)
# Database Connection (Supabase)
# Use Transaction mode url (port 6543) for best performance with serverless/API
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Redis Configuration (Broker/Cache)
REDIS_URL=redis://localhost:6379/0

# Application Ports
API_PORT=8000
WEB_PORT=3000

# Security (Future use)
SECRET_KEY=generate-a-secure-secret-key-here

# AI Model Configuration (Optional)
# GOOGLE_API_KEY=your-api-key-here
